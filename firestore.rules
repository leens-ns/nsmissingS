rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email == "leens@nsworld.net";
    }

    function currentPrivacyPolicyVersion() {
      return "2026-08-09";
    }

    function isEmploymentActive(data) {
      return 'employmentStartAt' in data
        && 'employmentEndAt' in data
        && data.employmentStartAt is timestamp
        && data.employmentEndAt is timestamp
        && request.time >= data.employmentStartAt
        && request.time <= data.employmentEndAt;
    }

    function hasAuthorizedAccount() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email))
        )
        && (
          isBootstrapAdmin()
          || get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.active == true
        )
        && (
          isBootstrapAdmin()
          || isEmploymentActive(get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data)
        );
    }

    function hasCurrentPrivacyConsent() {
      return signedIn()
        && exists(/databases/$(database)/documents/privacy_consents/$(request.auth.token.email))
        && get(/databases/$(database)/documents/privacy_consents/$(request.auth.token.email)).data.consentGiven == true
        && get(/databases/$(database)/documents/privacy_consents/$(request.auth.token.email)).data.policyVersion == currentPrivacyPolicyVersion();
    }

    function isAuthorizedTeacher() {
      return hasAuthorizedAccount() && hasCurrentPrivacyConsent();
    }

    function isAdmin() {
      return isAuthorizedTeacher()
        && (
          isBootstrapAdmin()
          || get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.role == "admin"
        );
    }

    function isValidPrivacyConsentWrite(email) {
      return hasAuthorizedAccount()
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly([
          "email", "consentGiven", "policyVersion", "consentedAt"
        ])
        && request.resource.data.email == email
        && request.resource.data.email.matches("^[A-Za-z0-9._%+-]+@nsworld[.]net$")
        && request.resource.data.consentGiven == true
        && request.resource.data.policyVersion == currentPrivacyPolicyVersion()
        && request.resource.data.consentedAt == request.time;
    }

    match /lost_items/{itemId} {
      allow read: if isAuthorizedTeacher();
      allow create, update, delete: if isAuthorizedTeacher();
    }

    match /public_lost_items/{itemId} {
      allow read: if isAuthorizedTeacher()
        || (resource.data.status in ["stored", "보관 중"]
          && resource.data.keys().hasOnly([
            "title", "category", "storageLocation", "foundPlace", "foundTime",
            "createdAt", "imageDataUrl", "imageUrl", "status"
          ]));
      allow create, update: if isAuthorizedTeacher()
        && request.resource.data.status in ["stored", "보관 중"]
        && request.resource.data.keys().hasOnly([
          "title", "category", "storageLocation", "foundPlace", "foundTime",
          "createdAt", "imageDataUrl", "imageUrl", "status"
        ]);
      allow delete: if isAuthorizedTeacher();
    }

    match /privacy_consents/{email} {
      allow read: if (signedIn() && request.auth.token.email == email) || isAdmin();
      allow create: if isValidPrivacyConsentWrite(email);
      allow update: if isValidPrivacyConsentWrite(email)
        && resource.data.policyVersion != currentPrivacyPolicyVersion();
      allow delete: if (signedIn() && request.auth.token.email == email) || isAdmin();
    }

    match /authorized_users/{email} {
      allow read: if (signedIn() && request.auth.token.email == email) || isAdmin();
      allow create, update: if isAdmin()
        && (email != "leens@nsworld.net" || request.auth.token.email == email)
        && request.resource.data.email == email
        && request.resource.data.email.matches("^[A-Za-z0-9._%+-]+@nsworld[.]net$")
        && request.resource.data.active is bool
        && request.resource.data.role in ["teacher", "admin"]
        && request.resource.data.keys().hasOnly([
          "email", "role", "name", "active",
          "addedBy", "addedAt", "updatedBy", "updatedAt",
          "disabledBy", "disabledAt",
          "employmentStartDate", "employmentEndDate",
          "employmentStartAt", "employmentEndAt"
        ])
        && "employmentStartAt" in request.resource.data
        && "employmentEndAt" in request.resource.data
        && request.resource.data.employmentStartAt is timestamp
        && request.resource.data.employmentEndAt is timestamp
        && request.resource.data.employmentStartAt <= request.resource.data.employmentEndAt;
      allow delete: if isAdmin()
        && email != "leens@nsworld.net"
        && request.auth.token.email != email;
    }

    match /app_settings/{settingId} {
      allow read: if isAuthorizedTeacher();
      allow create, update: if isAdmin()
        && settingId == "place_options"
        && request.resource.data.keys().hasOnly([
          "storageLocations", "foundPlaces", "updatedAt", "updatedBy"
        ])
        && request.resource.data.storageLocations is list
        && request.resource.data.foundPlaces is list
        && request.resource.data.storageLocations.size() <= 30
        && request.resource.data.foundPlaces.size() <= 30
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
