rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email == "leens@nsworld.net";
    }

    function isAuthorizedTeacher() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email))
        )
        && (
          isBootstrapAdmin()
          || get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.active == true
        );
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          isAuthorizedTeacher()
          && get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email)).data.role == "admin"
        );
    }

    match /lost_items/{itemId} {
      allow read: if isAuthorizedTeacher() || resource.data.status in ["stored", "보관 중"];
      allow create, update, delete: if isAuthorizedTeacher();
    }

    match /authorized_users/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.email.matches("^[A-Za-z0-9._%+-]+@nsworld\\.net$")
        && request.resource.data.active is bool
        && request.resource.data.role in ["teacher", "admin"];
      allow delete: if false;
    }

    match /app_settings/{settingId} {
      allow read: if isAuthorizedTeacher();
      allow create, update: if isAdmin()
        && settingId == "place_options";
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
